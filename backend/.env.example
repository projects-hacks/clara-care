# Deepgram (Voice Agent API)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# You.com (Nostalgia Search)
YOUCOM_API_KEY=your_youcom_api_key_here

# Supabase (PostgreSQL + Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Twilio (Outbound Phone Calls)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1your_twilio_number

# Email Alerts (SendGrid SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
FROM_EMAIL=alerts@claracare.me

# Dashboard URL (used in email notifications)
DASHBOARD_URL=https://claracare.me/dashboard

# Your server's public URL
SERVER_PUBLIC_URL=https://api.claracare.me

# Sentry DSN
SENTRY_DSN=https://your-sentry-dsn-here

